# Generate each token separately: openssl rand -hex 32
# API_TOKEN is mandatory. Never reuse it as the ingress credential.
API_TOKEN=
API_READ_TOKEN=
INGRESS_TOKEN=
PORT=8099
# Automatic HTTPS for certificate-pinned iOS QR pairing.
# Existing HTTP web access is preserved; no certificate installation needed.
TLS_PORT=8443
BIND_ADDRESS=0.0.0.0
PUID=1000
# Optional new container name; legacy KODI_LIBRARY_CONTAINER_NAME is still accepted.
HOME_MEDIA_CATALOG_CONTAINER_NAME=home-media-catalog
PGID=1000
# The first import runs when the catalogue is empty.
# Afterwards, web and iOS trigger an import on opening only when the
# last successful Kodi-to-MariaDB import exceeds 24 hours.
# No periodic scheduler is running; SYNC_INTERVAL is no longer used.
# true when every browser entry point uses HTTPS (HA ingress / reverse proxy).
COOKIE_SECURE=false
# CORS is unnecessary for iOS URLSession and same-origin UI/ingress.
CORS_ORIGINS=[]
# JSON mapping; prefixes must end in /. Mount these paths read-only in compose.
# ARTWORK_MOUNTS='{"smb://nas/media/posters/":"/artwork/"}'
ARTWORK_MOUNTS={}

# Optional: TMDB API Read Access Token or API v3 key (kept on the server).
# https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Optional: global retail GTIN lookup fallback. Paid Barcode Lookup API key, server only.
# Without it, the international UPCitemdb public service and BnF are still used.
BARCODELOOKUP_API_KEY=
# Optional: JSON CIDR arrays. Empty keeps authentication mandatory everywhere.
# LOCAL_AUTH_NETWORKS='["192.168.1.0/24","fd12:3456::/64"]'
LOCAL_AUTH_NETWORKS=[]
# Only actual reverse proxies that append/replace X-Forwarded-For correctly.
# Never add the whole LAN or Docker bridge just to bypass authentication.
# TRUSTED_PROXY_NETWORKS='["172.18.0.2/32"]'
TRUSTED_PROXY_NETWORKS=[]

# Optional on Linux/Synology if Docker hides the client behind its gateway IP.
# Host networking preserves client IPs for direct access at http://NAS:PORT.
# COMPOSE_FILE=compose.host.yaml:compose.dns.yaml

# Optional: used only with compose.dns.yaml. Choose your LAN resolver if needed.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8

# Bonjour/mDNS advertisement, for iOS local-network server discovery.
# Requires Docker host networking on Synology for multicast to reach the LAN.
# Use COMPOSE_FILE=compose.host.yaml:compose.dns.yaml and set PORT accordingly.
DISCOVERY_ENABLED=false
DISCOVERY_NAME=Home Media Catalog
# Defaults to PORT. Override if the externally reachable port differs.
# DISCOVERY_PORT=8099

# Optional playback cloud OAuth applications.
# Each provider must be registered on its developer portal with the same
# redirect URI as CLOUD_OAUTH_REDIRECT_URL, accessible via HTTPS.
# Format: {"dropbox":{"client_id":"..."},"google_drive":{"client_id":"...","client_secret":"..."}}
CLOUD_OAUTH_CLIENTS={}
CLOUD_OAUTH_REDIRECT_URL=
# Recommended: Fernet key, generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key stable across NAS/container upgrades.
PLAYBACK_ENCRYPTION_KEY=
